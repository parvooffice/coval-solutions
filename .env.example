# GitHub data is fetched only by server functions. Never prefix this token with NEXT_PUBLIC_.
# The analyzer project reads it for private repository archives; the dashboard also uses it for GitHub data.
GITHUB_TOKEN=
GITHUB_ORG=
# Optional fallback. GitHub OAuth login is used automatically when available.
# GITHUB_USERNAME=your-github-login

# Optional alternative to GITHUB_ORG. Use comma-separated owner/repository names.
# GITHUB_REPOS=owner/security-agent,owner/project-two,owner/project-three

# Optional limits for larger organizations.
GITHUB_REPO_PAGES=2
GITHUB_MEMBER_PAGES=2
GITHUB_ACTIVITY_REPOS=20
GITHUB_MAX_REPOS=100
GITHUB_MAX_PEOPLE=100

# Supabase GitHub OAuth and persistent messaging. The service role key is not used by this app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key
# Legacy fallbacks accepted by the server auth helper. Prefer the NEXT_PUBLIC_* names above.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Python analyzer runs as a separate Vercel project. Set this URL in the frontend project.
CODE_EVALUATION_API_URL=https://your-analyzer-project.vercel.app/api/code-evaluation-python
# Set the same long random secret in both Vercel projects. Never expose it with NEXT_PUBLIC_.
CODE_EVALUATION_FUNCTION_SECRET=

# Optional local CLI compatibility; not used by the Vercel deployment.
CODE_EVALUATION_PYTHON=
