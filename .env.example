# Supabase project credentials. The publishable key is safe in the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_project_key

# Optional server-side fallbacks. The app never uses a Supabase service-role key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-side GitHub token for public profile GraphQL enrichment.
GITHUB_TOKEN=
GITHUB_ACTIVITY_REPOS=20
GITHUB_MAX_PEOPLE=100

# Repository analyzer service. The web API and Python service must share the same random secret.
CODE_EVALUATION_API_URL=http://127.0.0.1:8000/api/code-evaluation-python
CODE_EVALUATION_FUNCTION_SECRET=replace_with_a_long_random_secret
CODE_EVALUATION_PYTHON=

# Report assistant (web app, server-only). Answers questions using the member's saved reports.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: an OpenAI-compatible endpoint (for example Azure OpenAI or a proxy).
OPENAI_BASE_URL=

# Payments (web app, server-only except the key ID). Create a monthly plan in Razorpay and paste its plan ID.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Random 32+ character secret; store the same value in Supabase coval_billing_config (see the billing migration).
COVAL_BILLING_SIGNING_SECRET=

# COVAL GitHub App (web app, server-only): private repositories and pull request comments.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM private key; keep the line breaks or write them as \n on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
# Public address of the web app, used in pull request comments.
COVAL_PUBLIC_URL=
