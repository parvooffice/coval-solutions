{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/code-evaluation-python.py": {
      "maxDuration": 300,
      "includeFiles": "{scripts/run-code-evaluation.py,documentation/**/*.py,modularity/**/*.py,security/src/**/*.py,error-handling/**/*.py}",
      "excludeFiles": "{**/tests/**,**/__pycache__/**,**/*.pyc,security/reports/**,modularity/reports/**,documentation/reports/**,error-handling/reports/**}"
    }
  }
}
