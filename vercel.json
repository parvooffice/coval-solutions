{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "app/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    },
    "api/code-evaluation-python.py": {
      "maxDuration": 300,
      "includeFiles": "{scripts/run-code-evaluation.py,documentation/**/*.py,modularity/**/*.py,security/src/**/*.py,error-handling/**/*.py,readability/**/*.py,test-coverage/**/*.py,agent-kit/*.py,performance/*.py,maintainability/*.py,scalability/*.py,standards/*.py}",
      "excludeFiles": "{**/tests/**,**/__pycache__/**,**/*.pyc,security/reports/**,modularity/reports/**,documentation/reports/**,error-handling/reports/**,readability/reports/**,test-coverage/reports/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path((?!code-evaluation-python$).*)",
      "destination": "/api"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(coval-logo-dark|coval-logo-light)\\.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
